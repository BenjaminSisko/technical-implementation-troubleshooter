{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:technical-implementation-troubleshooter:source-registry:v1",
  "title": "Troubleshooting Vendor Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "as_of", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "vendor",
          "product",
          "domain",
          "title",
          "canonical_url",
          "source_authority",
          "access_class",
          "redistribution_class",
          "default_classification",
          "acquisition_mode",
          "refresh_cadence",
          "status"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "vendor": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string", "pattern": "^https://"},
          "source_authority": {
            "enum": [
              "vendor-primary",
              "vendor-security",
              "vendor-source",
              "standards-primary",
              "organization-approved",
              "live-evidence"
            ]
          },
          "access_class": {
            "enum": [
              "public-anonymous",
              "public-account-required",
              "subscription-entitled",
              "developer-login-required",
              "organization-internal"
            ]
          },
          "redistribution_class": {
            "enum": [
              "public-permitted",
              "public-with-attribution",
              "public-share-alike",
              "metadata-only-public",
              "local-use-only",
              "manual-license-review",
              "unknown-quarantine"
            ]
          },
          "default_classification": {
            "enum": ["public", "private", "restricted"]
          },
          "acquisition_mode": {
            "enum": [
              "public-web",
              "authenticated-user-download",
              "package-repository-sync",
              "source-checkout",
              "local-command-export",
              "manual-media-import"
            ]
          },
          "version_strategy": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "parser_hint": {"type": "string", "minLength": 1},
          "refresh_cadence": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "active", "retired"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
